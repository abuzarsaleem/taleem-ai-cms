# PostgreSQL (Supabase — use Session pooler on IPv4 networks)
DB_ENABLED=true
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
DB_LOGGING=false

# App / Auth
PORT=3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
SEED_ADMIN_EMAIL=admin@taleem.local
SEED_ADMIN_PASSWORD=Admin@123
ALUMNI_PORTAL_URL=http://localhost:5173/activate
OPEN_SWAGGER=true
PUBLIC_BASE_URL=http://localhost:3000
ALUMNI_CARD_VERIFY_URL=http://localhost:3000/alumni/verify

# Storage: local | b2 | s3 | minio
STORAGE_DRIVER=b2

# Backblaze B2 (S3-compatible)
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_ACCESS_KEY=your-key-id
S3_SECRET_KEY=your-application-key
S3_BUCKET=taleem-alumni
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URLS=true
S3_SIGNED_URL_TTL_SECONDS=604800
S3_PUBLIC_URL=https://f005.backblazeb2.com/file/taleem-alumni

# Notifications: log | resend
NOTIFICATION_DRIVER=resend
RESEND_API_KEY=re_xxxxxxxx
# Verify your domain at https://resend.com/domains, then use your address.
# Until then: Taleem AI <onboarding@resend.dev> (sends only to your account email)
RESEND_FROM_EMAIL=Taleem AI <onboarding@resend.dev>
