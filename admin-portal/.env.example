# Local backend
# VITE_API_BASE_URL=http://localhost:3000/api/v1

# Production (Railway)
VITE_API_BASE_URL=https://taleem-ai-cms-production.up.railway.app/api/v1

# RSA public key (SPKI base64 or PEM). Must match backend PASSWORD_PUBLIC_KEY.
# Encryption: RSA-OAEP with SHA-256, sent as base64 ciphertext.
VITE_ENCRYPTION_KEY=
